{{define "title"}}Your new token{{end}}
{{define "main"}}
<main class="stack">
  <p class="crumbs"><a href="/tokens">agent tokens</a> / <span class="here">new</span></p>

  <div class="secret stack">
    <h1>Copy this token now. You will not see it again.</h1>
    <p>Nothing here keeps a copy, and neither does the git server: the token is signed, not stored. Nobody can recover this string once you leave this page — not you, not an administrator.</p>
    <div class="field">
      <label for="token">Token value</label>
      <input id="token" class="mono" readonly value="{{.Token}}" size="48">
    </div>
    <p class="meta">Tab to the field and copy it. There is no copy button here, because there is no script on any page of this interface and a button that cannot work is worse than none.</p>
  </div>

  <div class="panel stack">
    <dl class="facts">
      <dt>Repository</dt><dd class="path">{{.Repo.Owner}}/{{.Repo.Slug}}</dd>
      <dt>Scope</dt><dd class="refname">{{.Scope}}</dd>
      <dt>Expires</dt><dd class="when">{{.Expires}} — {{.ExpiresIn}} from now</dd>
    </dl>
    <h2>Use it</h2>
    <p class="meta">Put it in the agent's environment as <code>ORIGO_TOKEN</code>. Never in a repository, never in a prompt.</p>
    <pre class="scroller sample">{{.CloneLine}}

{{.ReadLine}}</pre>
    <p><a class="button" href="{{.BackURL}}">I have stored it</a> <span class="meta">Leaving this page any other way has the same effect.</span></p>
  </div>
</main>
{{end}}
