# What the stack installs beyond the overlay, pinned in one place (spec
# 013). up.sh and spec 018's install job source this file, so a bump is a
# one-line change the up-script and install jobs prove.
#
# The Cilium chart from https://helm.cilium.io; its default
# image.useDigest=true pins every Cilium image by digest.
CILIUM_CHART_VERSION=1.18.0
# metrics-server: the release manifest, its sha256, and its image by
# digest (the manifest list of registry.k8s.io/metrics-server/metrics-server:v0.7.2).
METRICS_SERVER_VERSION=v0.7.2
METRICS_SERVER_MANIFEST_SHA256=f103539a54ed72efe66616afc74a8bfaed651703cb3918797599046af5617441
METRICS_SERVER_IMAGE=registry.k8s.io/metrics-server/metrics-server@sha256:ffcb2bf004d6aa0a17d90e0247cf94f2865c8901dcab4427034c341951c239f9
